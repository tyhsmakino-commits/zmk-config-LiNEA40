#define ZMK_POINTING_DEFAULT_SCRL_VAL 150

#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define MOUSE 1
#define NUM 2
#define NAV 3
#define SYS 4

//mouse cursol

&mmv {
    delay-ms = <20>;
    trigger-period-ms = <5>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <2>;
};

//mouse scroll

&msc {
    delay-ms = <3>;
    trigger-period-ms = <3>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <0>;
};

/ {
    input_processors {
        zip_wheel_scaler: zip_wheel_scaler {
            compatible = "zmk,input-processor-scaler";
            #input-processor-cells = <2>;
            type = <INPUT_EV_REL>;
            codes = <INPUT_REL_WHEEL>;
            track-remainders;
        };
    };
};

&trackball_listener {
    scroller {
        layers = <NUM>;
        input-processors =
            <&zip_xy_transform INPUT_TRANSFORM_Y_INVERT>,
            //スクロール方向を逆転
            <&zip_xy_to_scroll_mapper>;
    };
};

// PC is set to the Japanese (JIS) layout, keycaps are US-printed.
// MM() makes a key send the printed character with and without Shift.
#define MM(name, plain, shifted) \
    name: name { \
        compatible = "zmk,behavior-mod-morph"; \
        #binding-cells = <0>; \
        bindings = <plain>, <shifted>; \
        mods = <(MOD_LSFT|MOD_RSFT)>; \
    };

&lt {
    flavor = "balanced";
    tapping-term-ms = <200>;
    quick-tap-ms = <175>;
};

/ {
    combos {
        compatible = "zmk,combos";

        DeleteKey {
            bindings = <&kp DEL>;
            key-positions = <7 8>;
            layers = <BASE MOUSE>;
        };

        CenterClick {
            bindings = <&mkp MB3>;
            key-positions = <16 17>;
            layers = <BASE MOUSE>;
        };

        RightClick {
            bindings = <&mkp MB2>;
            key-positions = <17 18>;
            layers = <BASE MOUSE>;
        };

        PrevClick {
            bindings = <&mkp MB4>;
            key-positions = <27 28>;
            layers = <BASE MOUSE>;
        };

        ClickNext {
            bindings = <&mkp MB5>;
            key-positions = <26 27>;
            layers = <BASE MOUSE>;
        };
    };

    behaviors {
        re_kp: sensor_rotate_kp {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&kp>, <&kp>;
        };

        mouse_scrl: mouse_wheel_scrl {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };

        //              plain          with Shift
        MM(us_quot, &kp LS(N7),    &kp LS(N2))     // '  "
        MM(us_semi, &kp SEMI,      &kp SQT)        // ;  :
        MM(us_n2,   &kp N2,        &kp LBKT)       // 2  @
        MM(us_n6,   &kp N6,        &kp EQUAL)      // 6  ^
        MM(us_n7,   &kp N7,        &kp LS(N6))     // 7  &
        MM(us_n8,   &kp N8,        &kp LS(SQT))    // 8  *
        MM(us_n9,   &kp N9,        &kp LS(N8))     // 9  (
        MM(us_n0,   &kp N0,        &kp LS(N9))     // 0  )
        MM(us_grv,  &kp LS(LBKT),  &kp LS(EQUAL))  // `  ~
        MM(us_mins, &kp MINUS,     &kp LS(INT1))   // -  _
        MM(us_eql,  &kp LS(MINUS), &kp LS(SEMI))   // =  +
        MM(us_lbkt, &kp RBKT,      &kp LS(RBKT))   // [  {
        MM(us_rbkt, &kp BSLH,      &kp LS(BSLH))   // ]  }
        MM(us_bsls, &kp INT3,      &kp LS(INT3))   // \  |
        MM(bar_esc, &kp MINUS,     &kp ESC)        // long vowel mark (-), Shift = Esc
    };

    keymap {
        compatible = "zmk,keymap";

        // 0: letters as printed on the keycaps
        default_layer {
            display-name = "Base";
            bindings = <
&kp Q      &kp W      &kp E     &kp R       &kp T                                    &kp Y  &kp U  &kp I      &kp O     &kp P
&kp A      &kp S      &kp D     &kp F       &kp G                                    &kp H  &kp J  &kp K      &kp L     &kp BSPC
&kp Z      &kp X      &kp C     &kp V       &kp B                                    &kp N  &kp M  &us_quot   &us_semi  &kp SLASH
&kp LSHFT  &kp LCTRL  &kp LALT  &kp C_MUTE  &lt NUM SPACE  &mt LGUI GRAVE    &lt NAV ENTER  &lt SYS TAB       &kp COMMA  &kp DOT   &bar_esc
            >;

            sensor-bindings = <&mouse_scrl SCRL_DOWN SCRL_UP>;
        };

        // 1: switched on automatically while the trackball moves
        MOUSE {
            display-name = "Mouse";
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans    &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &mkp MB1  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans    &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans            &trans  &trans  &trans
            >;
        };

        // 2: hold the dot key (left thumb). Numbers and symbols. "go" becomes Shift.
        NUM {
            display-name = "Num+Sym";
            bindings = <
&kp N1   &us_n2  &kp N3  &kp N4  &kp N5                       &us_n6    &us_n7   &us_n8    &us_n9    &us_n0
&us_grv  &trans  &trans  &trans  &trans                       &us_mins  &us_eql  &us_lbkt  &us_rbkt  &us_bsls
&trans   &trans  &trans  &trans  &trans                       &trans    &trans   &trans    &trans    &kp DEL
&trans   &trans  &trans  &trans  &trans  &trans    &kp LSHFT  &trans             &trans    &trans    &trans
            >;

            sensor-bindings = <&re_kp C_VOLUME_DOWN C_VOLUME_UP>;
        };

        // 3: hold "go" (right thumb). F keys and cursor keys. Knob scrolls sideways.
        NAV {
            display-name = "Fn+Nav";
            bindings = <
&kp F1   &kp F2   &kp F3  &kp F4  &kp F5                      &kp F6    &kp F7     &kp F8     &kp F9     &kp F10
&kp F11  &kp F12  &trans  &trans  &trans                      &kp LEFT  &kp DOWN   &kp UP     &kp RIGHT  &kp DEL
&trans   &trans   &trans  &trans  &kp PSCRN                   &kp HOME  &kp PG_DN  &kp PG_UP  &kp END    &trans
&trans   &trans   &trans  &trans  &kp SPACE  &trans    &trans  &trans              &trans     &trans     &trans
            >;

            sensor-bindings = <&mouse_scrl SCRL_RIGHT SCRL_LEFT>;
        };

        // 4: hold Tab. Bluetooth, ZMK Studio unlock, bootloader.
        SYS {
            display-name = "System";
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                  &bt BT_CLR  &bt BT_CLR_ALL  &none           &none  &bootloader
&none         &none         &none         &none         &none                         &none       &none           &none           &none  &none
&bootloader   &none         &none         &none         &none                         &none       &none           &none           &none  &none
&none         &none         &none         &none         &none         &none    &none  &trans                      &studio_unlock  &none  &none
            >;

            sensor-bindings = <&mouse_scrl SCRL_DOWN SCRL_UP>;
        };
    };
};
